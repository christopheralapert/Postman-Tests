  "item": [
    {
      "name": "Ülesanne 1 - GET kõik õpilased",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Staatus on 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Vastus on õpilaste massiiv\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "    pm.expect(data.length).to.be.above(0);",
              "    pm.expect(data[0]).to.include.all.keys(\"id\", \"name\", \"age\", \"major\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      },
      "response": []
    },
    {
      "name": "Ülesanne 2 - GET üks õpilane",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Staatus on 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Vastus sisaldab ainult õpilast ID-ga 1\", function () {",
              "    const student = pm.response.json();",
              "    pm.expect(student).to.be.an(\"object\");",
              "    pm.expect(student).to.not.be.an(\"array\");",
              "    pm.expect(student.id).to.eql(1);",
              "    pm.expect(student.name).to.eql(\"Alice\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/1",
          "host": ["{{baseUrl}}"],
          "path": ["students", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Ülesanne 3 - POST loo Katrin Kask",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Õpilane loodi staatusega 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const created = pm.response.json();",
              "pm.test(\"Loodud õpilase andmed vastavad requestile\", function () {",
              "    pm.expect(created.name).to.eql(\"Katrin Kask\");",
              "    pm.expect(created.age).to.eql(20);",
              "    pm.expect(created.major).to.eql(\"Computer Science\");",
              "    pm.expect(created.id).to.be.a(\"number\");",
              "});",
              "pm.collectionVariables.set(\"createdStudentId\", created.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Katrin Kask\",\n  \"age\": 20,\n  \"major\": \"Computer Science\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      },
      "response": []
    },
    {
      "name": "Ülesanne 3 - GET kontrolli loodud õpilast",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Kontroll-GET leiab loodud õpilase\", function () {",
              "    pm.response.to.have.status(200);",
              "    const student = pm.response.json();",
              "    pm.expect(student.id).to.eql(Number(pm.collectionVariables.get(\"createdStudentId\")));",
              "    pm.expect(student.name).to.eql(\"Katrin Kask\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/{{createdStudentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{createdStudentId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Ülesanne 4 - PUT muuda loodud õpilast",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Õpilase muutmine õnnestus\", function () {",
