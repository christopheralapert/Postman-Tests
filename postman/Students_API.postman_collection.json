{
  "info": {
    "_postman_id": "27b29183-2610-4e65-83d4-83dcc16c2001",
    "name": "Students API",
    "description": "Õpetaja Students API kontrollitud päringud.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ülesanne 1 - GET kõik õpilased",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Staatus on 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Vastus on õpilaste massiiv\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "    pm.expect(data.length).to.be.above(0);",
              "    pm.expect(data[0]).to.include.all.keys(\"id\", \"name\", \"age\", \"major\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
