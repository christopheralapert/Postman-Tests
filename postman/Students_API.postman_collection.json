              "    pm.expect(student.age).to.eql(21);",
              "    pm.expect(student.major).to.eql(\"Mathematics\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 21,\n  \"major\": \"Mathematics\"\n}",
